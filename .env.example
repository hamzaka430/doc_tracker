APP_NAME=DocTracker
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Main Application Database (Products, Users, SAP Errors)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=doc_tracker
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache (File driver avoids quota limits on Heroku JawsDB)
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cloudflare R2 / AWS S3 Storage (Profile Pictures & Screenshots)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Dedicated Aiven Cloud MySQL Database (Isolated Chat Storage)
CHAT_DB_HOST=
CHAT_DB_PORT=21102
CHAT_DB_DATABASE=defaultdb
CHAT_DB_USERNAME=
CHAT_DB_PASSWORD=
CHAT_DB_SSL_CA_PATH=
